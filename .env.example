# Slack app credentials (from api.slack.com/apps > your app > Basic Information / OAuth)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# HTTP port for the Bolt receiver. Railway/Render/Fly usually inject PORT automatically.
PORT=3000

# Supabase Postgres connection string.
# Supabase dashboard > Project Settings > Database > Connection string (URI).
# Use the pooled ("Transaction") connection string if your host does short-lived connections.
DATABASE_URL=postgres://user:password@host:5432/dbname

# The Slack workspace (team) ID this bot is allowed to operate in.
# Find it under Slack workspace settings > About this workspace, or from the URL
# of your workspace in a browser. This is an infra-level lock, not editable from
# inside Slack, so only whoever controls the deploy's env vars can change it.
SLACK_TEAM_ID=T0XXXXXXX
